FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps: build-essential for any wheel that needs compiling; git for
# pip install from VCS if needed; curl for the healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-lock.txt ./
RUN pip install --upgrade pip && pip install -r requirements-lock.txt

COPY . .

# Default to the training pipeline. The image produces a model artifact
# and exits 0 on success, non-zero on failure. Override the entrypoint
# to run tests or the API.
ENTRYPOINT ["python", "-m", "experiments.experiment_1"]
CMD []
